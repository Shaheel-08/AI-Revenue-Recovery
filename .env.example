# RecoverOS Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/recoveros.db

# Razorpay Test Mode (optional — mock mode used if not set)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_MOCK_MODE=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Guardrail Defaults
MAX_RETRIES=3
MAX_DISCOUNT_PERCENT=15
MAX_TOUCHPOINTS_72H=5
QUIET_HOUR_START=22
QUIET_HOUR_END=8
APPROVAL_THRESHOLD_AMOUNT=50000

# Synthetic Data
SYNTHETIC_DATA_SEED=42
SYNTHETIC_DATA_COUNT=2000
